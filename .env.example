# GEMINI_API_KEY: Required for Gemini AI API calls (from Google AI Studio).
# AI Studio automatically injects this at runtime from user secrets.
# When exporting & running locally, set your Google AI Studio API key here.
GEMINI_API_KEY=
# Optional override (defaults to gemini-4-argon; falls back to gemini-3.1-flash-lite)
# GEMINI_MODEL="gemini-4-argon"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# JWT_SECRET: Signing secret for HttpOnly session cookies (32+ chars in production)
JWT_SECRET="replace-with-32-char-random-secret"

# APP_ENV: 'demo' enables the non-production role switcher for live demonstrations
APP_ENV="demo"
ENABLE_DEMO_ROLE_SWITCHER="true"
PAUSE_AUTH_FOR_DEMO="true"

# DATABASE (required on Vercel / any serverless host)
# Serverless instances don't share a disk, so the database must be shared.
# Create a free Turso database (https://turso.tech), then:
#   turso db show <name> --url        -> TURSO_DATABASE_URL (libsql://...)
#   turso db tokens create <name>     -> TURSO_AUTH_TOKEN
# Leave both empty for local dev / Docker: a SQLite file in ./data is used instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
